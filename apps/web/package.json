{
  "name": "@cmeet/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "cmeet web frontend: Svelte 5 single-page app over the cmsg local API.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "svelte-check": "^4.0.0"
  }
}
